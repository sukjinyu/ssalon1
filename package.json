{
  "name": "ssalon1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts --production",
    "test": "node --test tests/*.test.ts",
    "cloudflare:build": "npm run build",
    "cloudflare:d1:create": "wrangler d1 create royal-salon-db",
    "cloudflare:d1:schema": "wrangler d1 execute royal-salon-db --remote --file migrations/0001_player_saves.sql",
    "cloudflare:deploy": "npm run build && wrangler pages deploy dist --project-name royal-salon"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "tsx": "^4.19.0"
  }
}
